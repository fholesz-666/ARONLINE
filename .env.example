# ARONLINE – příklad konfigurace. Zkopírujte do .env a doplňte.
# NIKDY necommitujte skutečný .env do Gitu.

# --- Základ -----------------------------------------------------------
# Veřejná adresa aplikace (bez lomítka na konci). V produkci https://
APP_URL=http://localhost:3000
# development | test | staging | production
APP_ENV=development

# --- Databáze (PostgreSQL 16) -----------------------------------------
DATABASE_URL=postgresql://postgres:heslo@localhost:5432/aronline
# Pro hostované DB s TLS (Render, Neon…) nastavte true
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Migrace a doplnění ceníku při startu serveru (false = ručně: npm run db:migrate)
AUTO_MIGRATE=true

# --- Platby -----------------------------------------------------------
# mock = simulovaná brána (jen vývoj), sandbox = testovací GoPay, production = ostrý provoz
PAYMENTS_MODE=mock
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
# Předplatné přes opakované platby – v produkci musí GoPay opakované platby aktivovat
GOPAY_RECURRENCE_ENABLED=true

# --- Obchodní pravidla --------------------------------------------------
# Blokovat platby a placené exporty, dokud není výpočetní jádro odborně ověřeno (doporučeno true)
REQUIRE_VERIFIED_CORE=true
# Rozsah náhledu výsledku před zaplacením: summary | full
PREVIEW_DETAIL=summary
# Verze obchodních podmínek, se kterou uživatel souhlasí při registraci
TERMS_VERSION=2026-10-navrh

# --- E-maily (SMTP) ---------------------------------------------------
# Bez SMTP se ve vývoji e-maily vypisují do konzole, v produkci se neodešlou.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="ARONLINE <no-reply@example.cz>"

# --- Provozovatel (patička, právní texty) ------------------------------
OPERATOR_NAME=
OPERATOR_ICO=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
# true = ceny jsou uváděny včetně DPH
OPERATOR_VAT_PAYER=false

# --- Správa -----------------------------------------------------------
# E-maily, které při registraci dostanou roli správce (čárkou oddělené)
ADMIN_EMAILS=
